<Page x:Class="WpfApp1.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Авторизация"
      Background="White"
      Unloaded="Page_Unloaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="340">

            
            <TextBlock Text="Логин" FontSize="15" Margin="0,0,0,8"/>
            <TextBox x:Name="tbLogin" Padding="10,8" FontSize="15" Height="42"/>

            
            <TextBlock Text="Пароль" FontSize="15" Margin="0,20,0,8"/>
            <Grid>
                <PasswordBox x:Name="pbPassword" Padding="10,8" FontSize="15" Height="42"/>
                <TextBox x:Name="tbPasswordVisible" Padding="10,8" FontSize="15" Height="42" Visibility="Collapsed"/>
            </Grid>
            <CheckBox x:Name="chkShowPassword" Content="Показать пароль" 
                      Margin="0,10,0,0" FontSize="14"
                      Checked="ChkShowPassword_Checked" Unchecked="ChkShowPassword_Unchecked"/>

           
            <Border x:Name="bdCaptcha" Visibility="Collapsed" 
                    BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Padding="15" Margin="0,25,0,0" Background="#FFF8F8F8" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Введите код с картинки:" FontSize="14" Margin="0,0,0,10"/> 
                    <TextBlock x:Name="tblCaptcha" FontFamily="Courier New" 
                               FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="#FF333333" Background="#FFFFFACD" Padding="12,8"/>
                    <TextBox x:Name="tbCaptcha" Padding="10" FontSize="15" Height="40" Margin="0,12,0,0"/>
                    
                    <Button x:Name="btnRefreshCaptcha" Content="Обновить" Height="45" Padding="20,8" FontSize="14" HorizontalAlignment="Center" Click="BtnRefreshCaptcha_Click"/>
                </StackPanel>
            </Border>

           
            <TextBlock x:Name="lblAttempts" Foreground="#FFFF6600" FontSize="15"
                       HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

            
            <Border x:Name="bdLockout" Visibility="Collapsed" 
        BorderBrush="#FFD32F2F" BorderThickness="1" 
        Padding="20,15" Margin="0,20,0,0" Background="#FFFDEDED" CornerRadius="5"
        HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" MinWidth="280">
                    <TextBlock x:Name="lblLockout" 
                   Text="Превышено число попыток." 
                   Foreground="#FFD32F2F" 
                   FontSize="15" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbTimer" 
                   Foreground="#FFD32F2F" 
                   FontSize="15" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button x:Name="btnEnterGuests" Content="Войти как гость" 
                        Width="150" Height="45" FontSize="15"
                        Margin="0,0,15,0"
                        Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Content="Войти" 
                        Width="165" Height="45" FontSize="15"
                        Click="btnEnter_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>